# Render backend. Set these in the Render dashboard; do not commit an actual .env.
RISKSCOPE_MODE=hosted
RISKSCOPE_ALLOWED_ORIGINS=https://your-project.vercel.app
# Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# For an additional custom API hostname:
# RISKSCOPE_ALLOWED_HOSTS=api.example.com
RISKSCOPE_GUEST_IDLE_SECONDS=3600
RISKSCOPE_GUEST_LIFETIME_SECONDS=14400
RISKSCOPE_GUEST_MAX_SESSIONS=12
RISKSCOPE_GUEST_WORKSPACE_BYTES=33554432
RISKSCOPE_GUEST_UPLOAD_BYTES=2097152
RISKSCOPE_GUEST_MAX_CORRELATIONS=5000
